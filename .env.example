# Non-secret config — copy to .env and fill in if you want anything but the
# default. Nothing here is required: with an empty file the API runs the stub
# agent, and the whole test suite runs with no model at all.

# Agent mode behind /chat: stub (default) | local.
# NOTE: nothing auto-loads this file; run with `uvicorn ... --env-file .env`
# (make run-local does) or export the variables in your shell. An explicit mode
# with missing settings fails loud rather than silently falling back.
HARNESS_AGENT_MODE=

# --- local mode: Microsoft Agent Framework on-device, via Foundry Local
# (https://www.foundrylocal.ai). Nothing to install: with the endpoint left
# empty the bundled foundry-local-sdk boots the runtime in-process and the
# FIRST /chat downloads the model (one-time, ~2-3 GB for the default).
# Set the endpoint only to reuse a Foundry Local server you run yourself.
FOUNDRY_LOCAL_ENDPOINT=
FOUNDRY_LOCAL_MODEL=phi-4-mini
